# Set secrets in Vercel Settings > Environment Variables. Never commit them.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional alternative provider (Anthropic takes priority when configured).
AI_GATEWAY_API_KEY=
# Optional with Vercel OIDC; choose an available structured-output model.
AI_MODEL=google/gemini-3.5-flash-lite
# Required before live extraction is enabled. Shared demo access code, not an API key.
APP_ACCESS_CODE=
# Optional shared workspace. These are public browser configuration, not secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
